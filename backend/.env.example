# ==============================================================================
# AI Resume Analysis & Career Assistance Platform - Backend Environment Config
# ==============================================================================
# Copy this file to .env for local development:
# Windows: copy .env.example .env
# Linux/Mac: cp .env.example .env

# --- Application Configuration ---
APP_NAME="AI Resume Analysis & Career Assistance Platform"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# --- Server Host & Port ---
HOST="127.0.0.1"
PORT=8000

# --- CORS Allowed Origins (Comma-separated) ---
# Add your frontend URLs here:
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"

# --- Future Database Integration (MySQL Placeholder) ---
# Will be configured in Phase 2:
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/resume_platform"

# --- Future Authentication (Google OAuth 2.0 Placeholders) ---
# Will be configured in Phase 3:
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
JWT_SECRET_KEY="your-secret-key-for-token-signing"

# --- Future AI & ML Services (Gemini API / Model Placeholders) ---
# Will be configured in Phase 4:
GEMINI_API_KEY="your-gemini-api-key"
